<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>Repatch — content-aware fill for PixInsight. Update repository of https://github.com/awitwicki/Repatch</p>
   </description>
   <metadata id="20261121-repatch-0.1.1" releaseDate="20261121">
      <title>Repatch Module Version 0.1.1</title>
      <description>
         <p>Repatch 0.1.1: content-aware fill (PatchMatch) for PixInsight, with a healing-brush interface and a mask-image mode. Requires PixInsight 1.9.6.</p>
         <p>Changes: built against PCL 2.11.0; the documentation page now includes the PixInsight Class Library acknowledgment, copyright notice and license, and states that Repatch makes no network connections, launches no external programs and stores no files outside the PixInsight installation.</p>
      </description>
   </metadata>
   <platform os="macosx" arch="arm64" version="1.9.6:1.9.6">
      <package fileName="Repatch-0.1.1-macosx-arm64.tar.gz" serverURL="https://awitwicki.github.io/Repatch/" sha1="3cbd4c8aea9201c1f9e363337f68994b62181570" type="module" metadata="20261121-repatch-0.1.1">
         <remove>
            bin/Repatch-pxm.dylib, bin/Repatch-pxm.xsgn
         </remove>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.6:1.9.6">
      <package fileName="Repatch-0.1.1-windows-x64.tar.gz" serverURL="https://awitwicki.github.io/Repatch/" sha1="fd7c59176e59223380fa7eeb1eb182b28bdaefe0" type="module" metadata="20261121-repatch-0.1.1">
         <remove>
            bin/Repatch-pxm.dll, bin/Repatch-pxm.xsgn
         </remove>
      </package>
   </platform>
</xri>
