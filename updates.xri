<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>Repatch — content-aware fill for PixInsight. Update repository of https://github.com/awitwicki/Repatch</p>
   </description>
   <metadata id="20261001-repatch-0.1.0" releaseDate="20261001">
      <title>Repatch Module Version 0.1.0</title>
      <description>
         <p>Repatch 0.1.0: content-aware fill (PatchMatch) for PixInsight, with a healing-brush interface and a mask-image mode. Requires PixInsight 1.9.4 or 1.9.5 on macOS (Apple Silicon), PixInsight 1.9.5 on Windows (x64).</p>
      </description>
   </metadata>
   <platform os="macosx" arch="arm64" version="1.9.4:1.9.5">
      <package fileName="Repatch-0.1.0-macosx-arm64.tar.gz" serverURL="https://awitwicki.github.io/Repatch/" sha1="e5e26ebd64a74f065e247ebc549ae0cfeb8acb94" type="module" metadata="20261001-repatch-0.1.0">
         <remove>
            bin/Repatch-pxm.dylib, bin/Repatch-pxm.xsgn
         </remove>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.5:1.9.5">
      <package fileName="Repatch-0.1.0-windows-x64.tar.gz" serverURL="https://awitwicki.github.io/Repatch/" sha1="5dad30bdcf2fc367e7f51e9445060d23c2b01d52" type="module" metadata="20261001-repatch-0.1.0">
         <remove>
            bin/Repatch-pxm.dll, bin/Repatch-pxm.xsgn
         </remove>
      </package>
   </platform>
</xri>
